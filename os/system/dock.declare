/*
# The dock

A translucent plate holding one icon per registry app, then a tile per
minimized window. It magnifies by layout, not paint: each icon's width springs
toward a wave read from the pointer's distance to its resting center, so
neighbors displace and the plate stretches to hold them. Minimized windows
park here as live thumbnails riding the same wave.

Adapted from the Declare desktop (apps/desktop/desktop.declare).
*/

class Dock [ height = 150,

    // ── geometry ──

    iconEdge: number = 44,                       // a dock icon's resting edge
    badgeEdge: number = 20,                      // a minimized window's app badge, at rest
    thumbEdge: number = 64,                      // a minimized thumbnail's longer edge

    // the launch bounce, asked of the dock by app id
    pokeIcon(icon: DockIcon) { icon.poke() },
    poke(id: string) {
        for (const c of this.row.children) if ((c as DockIcon).appId == id) this.pokeIcon(c as DockIcon)
        },

    // a spring that chases the pointer, so the wave glides between events
    dockX: number = 0,
    dockXSpring: Spring [ attribute = dockX, to = { app.pointerX }, stiffness = 1300, damping = 62, epsilon = 0.5 ],

    // distance from an icon's resting center → magnification: a pointed
    // peak of 1.55× falling off over four icon pitches
    dockMag(dist: number) -> number {
        const pitch = this.iconEdge + 16
        const a = Math.abs(dist)
        const xs = [0, pitch, 2 * pitch, 3 * pitch, 4 * pitch]
        const ys = [1.55, 1.35, 1.18, 1.06, 1]
        if (a >= xs[4]) return 1
        for (let i = 0; i < 4; i++) {
            if (a <= xs[i + 1]) return ys[i] + (ys[i + 1] - ys[i]) * (a - xs[i]) / (xs[i + 1] - xs[i])
            }
        return 1
        },

    // the parked strip, fitted: each thumbnail's longer edge is thumbEdge
    tiles: array = { (app.wm.minis() || []).map((r, i) => {
        const fit = this.thumbEdge / Math.max(r.winW, r.winH)
        return ({ ix: i, label: r.label, w: Math.round(r.winW * fit), h: Math.round(r.winH * fit) })
        }) },
    miniGoal: number = { this.tiles.length > 0 ? this.tiles.reduce((t, r) => t + r.w + 8, 0) + 26 : 0 },
    miniSpan: number = 0,
    spanSpring: Spring [ attribute = miniSpan, to = { classroot.miniGoal }, stiffness = 380, damping = 34, epsilon = 0.5 ],

    // one layout both the parked windows and their hit tiles read
    miniLayout: array = { this.computeMiniLayout(this.tiles, this.dockX, this.hot,
        this.x, this.row.width, this.miniSpan, app.width, app.launcher.apps.length) },

    computeMiniLayout(recs: array, px: number, hot: number, dockLeftX: number, rowW: number, span: number, appW: number, n: number) -> array {
        const rs = recs || []
        const iconRow = n * this.iconEdge + Math.max(0, n - 1) * 16
        const restDockX = (appW - (iconRow + 32 + span)) / 2
        let rx = restDockX + 16 + iconRow + 34      // first slot's resting left
        let lx = dockLeftX + 16 + rowW + 34         // …and its live left
        const out = []
        for (const r of rs) {
            const cx0 = rx + r.w / 2
            const m = 1 + (this.dockMag(px - cx0) - 1) * hot
            const w = r.w * m
            out.push(({ x: lx, w: w, rw: r.w, h: (r.h || r.w) * m, cx: lx + w / 2 }))
            lx += w + 8
            rx += r.w + 8
            }
        return out
        },

    miniMagX: number = { this.magOf(this.miniLayout, this.tiles) },
    magOf(lay: array, recs: array) -> number {
        if (lay == null || recs == null || lay.length == 0) return 0
        let d = 0
        for (let i = 0; i < lay.length; i++) d += lay[i].w - recs[i].w
        return Math.max(0, d)
        },

    width = { this.plate.width },
    x = center,
    y = { app.height - 155.5 },                  // the 88px plate sits 5.5px off the bottom edge

    // the enter/exit envelope: arms near the bottom edge, holds higher
    // while hot so a magnified icon's crest stays inside the band
    armBand: number = 100,
    holdBand: number = 132,
    hot: number = 0,
    hotGate: number = { app.hovering && app.pointerY > app.height - (this.hot > 0.5 ? this.holdBand : this.armBand) ? 1 : 0 },
    heat: Spring [ attribute = hot, to = { classroot.hotGate }, stiffness = 3600, damping = 120, epsilon = 0.002 ],

    plate: View [ x = 0, y = { parent.height - 88 }, height = 88, width = { parent.row.width + 32 + classroot.miniSpan + classroot.miniMagX },
        cornerRadius = 27, fill = { app.darkMode ? 0x2A2A30 : 0xFCFCFE }, opacity = 0.4 ],

    plateRim: View [ x = 0, y = { parent.height - 88 }, height = 88, width = { parent.plate.width },
        draw(d: Draw) {
            const w = this.width
            const h = this.height
            const r = 27
            d.strokeStyle = app.darkMode ? "rgba(0,0,0,0.34)" : "rgba(112,124,148,0.22)"
            d.lineWidth = 1
            d.beginPath()
            d.roundRect(0.5, 0.5, w - 1, h - 1, r - 0.5)
            d.stroke()
            const g = d.createLinearGradient(0, 0, 0, h)
            g.addColorStop(0, app.darkMode ? "rgba(255,255,255,0.30)" : "rgba(255,255,255,0.62)")
            g.addColorStop(0.42, app.darkMode ? "rgba(255,255,255,0.05)" : "rgba(255,255,255,0.13)")
            g.addColorStop(1, "rgba(255,255,255,0)")
            d.strokeStyle = g
            d.lineWidth = 1.5
            d.beginPath()
            d.roundRect(1.4, 1.4, w - 2.8, h - 2.8, r - 1.4)
            d.stroke()
            }
        ],

    // one icon per registry app, replicated from the launcher's dock rows
    row: View [ x = 16, y = 0, height = 100%,
        datapath = { app.launcher.dockData.value },
        layout: SimpleLayout [ axis = x, spacing = 16 ],
        DockIcon [ datapath = :apps[], key = :id,
            hotGate = { classroot.hotGate },
            ix = { rowIndex },
            appId = { "" + (:id ?? "") },
            running = { :running == true },
            onClick() { const id = this.appId; app.wm.dockOpen(id, () => app.launcher.launch(id, this)) }
            ]
        ],

    // the minimized-window section: a divider, then a hit tile per window
    minis: View [ visible = { classroot.miniSpan > 0.5 },
        x = { parent.row.x + parent.row.width + 16 }, y = 0, height = 100%,
        div: View [ x = 0, y = { parent.height - 77 }, width = 1, height = 65,
            opacity = { Math.min(1, classroot.miniSpan / 26) },
            fill = { app.darkMode ? 0xFFFFFF48 : 0x00000042 } ],
        rowM: View [ x = 0, y = 0, height = 100%,
            datapath = { app.wm.miniData.value },
            MiniTile [ datapath = :minis[], key = :id ]
            ]
        ]
    ]


/*
## LabelPill — the dock's tooltip

A stadium body with a small tail, translucent so the wallpaper shows through.
*/

class LabelPill [ height = 33,
    label: string = "",
    bodyH: number = 22,
    width = { this.t.width + 26 },
    draw(d: Draw) {
        const w = this.width, bh = this.bodyH, dark = app.darkMode
        const r = bh / 2
        const th = 7
        const hb = 8
        const cx = w / 2
        d.beginPath()
        d.moveTo(r, 0)
        d.lineTo(w - r, 0)
        d.arc(w - r, r, r, -Math.PI / 2, Math.PI / 2, false)
        d.lineTo(cx + hb, bh)
        d.lineTo(cx, bh + th)
        d.lineTo(cx - hb, bh)
        d.lineTo(r, bh)
        d.arc(r, r, r, Math.PI / 2, Math.PI * 1.5, false)
        d.closePath()
        d.fillStyle = dark ? "rgba(46,46,51,0.9)" : "rgba(242,242,246,0.88)"
        d.fill()
        d.strokeStyle = dark ? "rgba(0,0,0,0.35)" : "rgba(196,196,204,0.85)"
        d.lineWidth = 1
        d.stroke()
        },
    t: Text [ x = center, y = { (classroot.bodyH - this.height) / 2 }, fontSize = 13,
        textColor = { app.darkMode ? 0xF2F2F5 : 0x1D1D1F },
        text = { classroot.label } ]
    ]


/*
## DockIcon — an app's icon that magnifies by layout
*/

class DockIcon [
    ix: number = 0,                              // resting slot index
    slots: number = { app.launcher.apps.length },
    appId: string = "",
    rec: AppRec? = { app.launcher.byId(this.appId) },
    running: boolean = false,

    rest: number = { app.dock.iconEdge },
    pitch: number = { app.dock.iconEdge + 16 },
    strip: number = 16,                          // the running-dot band below the icons

    // the resting slot center in app coords — the wave never reads the
    // magnified layout (that would feed back on itself)
    cx0: number = { app.width / 2 + (this.ix - (this.slots - 1) / 2) * this.pitch - app.dock.miniSpan / 2 },

    hotGate: number = 0,                         // 0 = no wave (a badge); the dock row feeds its live gate
    magTarget: number = { 1 + (app.dock.dockMag(app.pointerX - this.cx0) - 1) * this.hotGate },
    mag: number = 1,
    magSpring: Spring [ attribute = mag, to = { classroot.magTarget }, stiffness = 1300, damping = 62, epsilon = 0.002 ],
    width  = { this.rest * this.mag },
    height = { this.width },
    y = { parent.height - this.height - this.strip - this.hopY },

    // the launch bounce: two ballistic hops
    hopY: number = 0,
    bounce: AnimatorGroup [ attribute = hopY, process = sequential,
        Animator [ to = 30, duration = 300, motion = quadOut ],
        Animator [ to = 0, duration = 260, motion = quadIn ],
        Animator [ to = 30, duration = 300, motion = quadOut ],
        Animator [ to = 0, duration = 260, motion = quadIn ]
        ],
    poke() { this.bounce.start() },

    face: AppGlyph [ x = 0, y = 0, edge = { classroot.width }, appId = { classroot.appId },
        rim: View [ x = 0, y = 0, width = 100%, height = 100%,
            draw(d: Draw) {
                const w = this.width
                const h = this.height
                if (w < 3 || h < 3) return
                const r = w * 0.23
                const g = d.createLinearGradient(0, 0, 0, h)
                g.addColorStop(0, "rgba(255,255,255,0.42)")
                g.addColorStop(0.34, "rgba(255,255,255,0.07)")
                g.addColorStop(1, "rgba(255,255,255,0)")
                d.strokeStyle = g
                d.lineWidth = 1
                d.beginPath()
                d.roundRect(0.5, 0.5, w - 1, h - 1, r - 0.5)
                d.stroke()
                }
            ]
        ],

    dot: View [ width = 4, height = 4, cornerRadius = 2,
        x = center, y = { parent.height + 6 + this.parent.hopY },
        visible = { classroot.running }, fill = { provided("theme").text } ],

    pill: LabelPill [ visible = { classroot.hovered },
        x = center,
        y = { parent.height - 130 },
        label = { classroot.rec?.label ?? "" } ]
    ]


/*
## MiniTile — a minimized window's dock tile

An invisible click target riding the same wave as the icons, above the
parked window itself (which is the thumbnail).
*/

class MiniTile [
    ix: number = { rowIndex },
    recId: string = { "" + (:id ?? "") },
    lbl: string = { "" + (:label ?? "") },
    appId: string = { "" + (:appId ?? "") },

    slotW: number = { app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].w : 48 },
    slotH: number = { app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].h : 48 },
    slotRestW: number = { app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].rw : 48 },
    waveMag: number = { this.slotW / Math.max(1, this.slotRestW) },
    x = { (app.dock.miniLayout != null && this.ix < app.dock.miniLayout.length ? app.dock.miniLayout[this.ix].x : 0) - (app.dock.x + app.dock.row.width + 32) },
    width = { this.slotW },
    height = { this.slotH },
    y = { parent.height - 13.5 - 30.5 * this.waveMag - this.height / 2 },
    onClick() { app.wm.restoreMiniAt(this.ix) },

    seated: boolean = { app.wm.seated(this.recId, this.slotW) },

    badge: AppGlyph [
        visible = { classroot.seated },
        edge = { app.dock.badgeEdge * classroot.waveMag },
        x = { parent.width - (app.dock.badgeEdge + 2) * classroot.waveMag },
        y = { parent.height / 2 + (30.5 - app.dock.badgeEdge) * classroot.waveMag },
        appId = { classroot.appId }
        ],

    pill: LabelPill [ visible = { classroot.hovered },
        x = center,
        y = { parent.height / 2 - 102 },
        label = { classroot.lbl } ]
    ]
