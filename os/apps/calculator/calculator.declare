/*
# Calculator — a four-function calculator

The keys are records (`pad`), replicated into a wrapping grid; each key is a
`CalcKey` control whose press hands its record back to the App. The App holds
the whole state: the display, the pending operator, and the stored operand.
*/

class CalcKey extends Control [ height = 58, cornerRadius = 29,
    label: string = "",
    kind: string = "num",                        // "num" | "fn" | "op"
    wide: boolean = false,
    width = { this.wide ? 58 * 2 + 12 : 58 },
    fill = { this.kind == "op" ? provided("theme").keyOp : this.kind == "fn" ? provided("theme").keyFn : provided("theme").key },
    opacity = { this.pressed ? 0.7 : 1 },
    hit() { },
    press() { this.hit() },
    t: Text [ x = { classroot.wide ? 22 : (classroot.width - this.width) / 2 }, y = center, fontSize = 24, fontWeight = medium,
        textColor = { classroot.kind == "fn" ? provided("theme").textFn : provided("theme").text },
        text = { classroot.label } ]
    ]

// the keys' colors are tokens on top of a full preset (the library's
// controls read the preset's own tokens, so a theme always starts from one)
App [ appName = "Calculator",
    theme = { { ...CupertinoDark, surface: 0x1C1C1E, key: 0x333336, keyFn: 0xA5A5AA, keyOp: 0xFF9F0A, text: 0xFFFFFF, textFn: 0x1C1C1E } }, fill = { provided("theme").surface },

    display: string = "0",
    stored: number = 0,
    op: string = "",                             // the pending operator, "" for none
    fresh: boolean = true,                       // the next digit starts a new number

    pad: Dataset { { "keys": [
        { "id": "c", "label": "C", "kind": "fn" }, { "id": "neg", "label": "±", "kind": "fn" },
        { "id": "pct", "label": "%", "kind": "fn" }, { "id": "÷", "label": "÷", "kind": "op" },
        { "id": "7", "label": "7", "kind": "num" }, { "id": "8", "label": "8", "kind": "num" },
        { "id": "9", "label": "9", "kind": "num" }, { "id": "×", "label": "×", "kind": "op" },
        { "id": "4", "label": "4", "kind": "num" }, { "id": "5", "label": "5", "kind": "num" },
        { "id": "6", "label": "6", "kind": "num" }, { "id": "−", "label": "−", "kind": "op" },
        { "id": "1", "label": "1", "kind": "num" }, { "id": "2", "label": "2", "kind": "num" },
        { "id": "3", "label": "3", "kind": "num" }, { "id": "+", "label": "+", "kind": "op" },
        { "id": "0", "label": "0", "kind": "num", "wide": true }, { "id": ".", "label": ".", "kind": "num" },
        { "id": "=", "label": "=", "kind": "op" }
        ] } },

    apply(a: number, b: number, o: string) -> number {
        if (o == "+") return a + b
        if (o == "−") return a - b
        if (o == "×") return a * b
        if (o == "÷") return b == 0 ? NaN : a / b
        return b
        },
    show(n: number) -> string {
        if (!isFinite(n)) return "Error"
        const s = "" + parseFloat(n.toPrecision(10))
        return s.length > 12 ? n.toExponential(5) : s
        },

    key(id: string) {
        const cur = parseFloat(display)
        if (id >= "0" && id <= "9" || id == ".") {
            if (fresh) { display = id == "." ? "0." : id; fresh = false }
            else if (!(id == "." && display.indexOf(".") >= 0) && display.length < 12) display = display == "0" && id != "." ? id : display + id
            }
        else if (id == "c") { display = "0"; stored = 0; op = ""; fresh = true }
        else if (id == "neg") display = this.show(-cur)
        else if (id == "pct") display = this.show(cur / 100)
        else if (id == "=") { display = this.show(this.apply(stored, cur, op)); op = ""; fresh = true }
        else {
            stored = op != "" && !fresh ? this.apply(stored, cur, op) : cur
            display = this.show(stored)
            op = id
            fresh = true
            }
        },

    body: View [ x = center, y = end, width = { 58 * 4 + 12 * 3 }, padding = [0, 0, 18, 0],
        layout: SimpleLayout [ axis = y, spacing = 14 ],
        readout: Text [ x = end, fontSize = 52, fontWeight = light, textColor = { provided("theme").text },
            text = { app.display } ],
        grid: View [ width = 100%, datapath = { app.pad.value },
            layout: WrappingLayout [ spacing = 12, rowSpacing = 12 ],
            CalcKey [ datapath = :keys[], label = :label, kind = :kind, wide = { :wide == true },
                hit() { app.key("" + :id) } ]
            ]
        ]
    ]
